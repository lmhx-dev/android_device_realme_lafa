<resources>
    <!-- The number of vibration intensity levels supported by the device.
         lafa uses the AAC richtap / awinic backend; the stock ROM exposes
         separate ALARM / RINGTONE / NOTIFICATION / TOUCH intensities, so three
         levels is the right granularity. -->
    <integer name="config_vibration_supported_intensity_levels">3</integer>

    <!-- Display settings screen, Color mode options. Must stay in sync with the
         config_availableColorModes list in OPlusFrameworksResTarget.

         These two arrays are index-paired (ColorModeUtils.getColorModeMapping
         zips them, and throws "Color mode options of unequal length" if their
         lengths differ): values[i] is the ColorDisplayManager value whose label
         is strings[i]. The *display order* in Settings comes from
         config_availableColorModes, not from here - that is why the values look
         out of order (1, 0, 2) while the labels below stay in their original
         Standard/Natural/Vivid order.

         Switched from OPPO QDCM render intents (301/303/307) to DTM's 0-2; see
         the long note in OPlusFrameworksResTarget for why the former cannot
         change the gamut on this panel. -->
    <string-array name="config_color_mode_options_strings" translatable="false">
        <item>Standard</item>
        <item>Natural</item>
        <item>Vivid</item>
    </string-array>
    <integer-array name="config_color_mode_options_values" translatable="false">
        <item>0</item>
        <item>1</item>
        <item>2</item>
    </integer-array>

    <!-- TODO(phase6): config_udfpsEnrollProgressBar is not set. lafa's UDFPS is a
         Goodix sensor (persist.vendor.fingerprint.fp_id=G_DOLPHIN_GUM_uff) with
         icon size 220 and circle count 10 at (720, 2316); the radius should be
         derived from that on a device rather than guessed. -->
</resources>
